# Use ONE combined credential, with both parts from Higgsfield's API console.
HIGGSFIELD_API_KEY=YOUR_KEY_ID:YOUR_KEY_SECRET
# Also supported: HF_KEY, HF_CREDENTIALS, or HF_API_KEY plus HF_API_SECRET.
# Production is the default. Set this only when model docs specify another host.
# HF_BASE_URL=https://api.higgsfield.ai
